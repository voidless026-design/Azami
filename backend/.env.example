# Azami backend configuration (copy to .env and edit). All keys are prefixed AZAMI_.

# --- Core ---
AZAMI_ENVIRONMENT=development

# --- Storage ---
# Default is a local SQLite file. For production use PostgreSQL, e.g.:
# AZAMI_DATABASE_URL=postgresql+psycopg://azami:password@localhost:5432/azami
# AZAMI_DATABASE_URL=sqlite:///./.azami_data/azami.db

# --- Auth ---
# CHANGE THESE. jwt_secret must be a long random string in production.
AZAMI_JWT_SECRET=change-me-to-a-long-random-string
AZAMI_BOOTSTRAP_ADMIN_USERNAME=admin
AZAMI_BOOTSTRAP_ADMIN_PASSWORD=changeme

# --- Authorization ---
# PRODUCTION MUST be false: scopes must carry a valid signature.
# Set true only for local development to load unsigned scope files.
AZAMI_ALLOW_UNSIGNED_SCOPES=true

# --- Execution ---
# local  = run tools as local subprocesses (dev; requires the tools installed)
# docker = run each tool in a pinned container (recommended)
# remote = submit to a remote runner service
AZAMI_RUNNER_BACKEND=local
# AZAMI_REMOTE_RUNNER_URL=https://runners.internal.example/api
AZAMI_MAX_GLOBAL_CONCURRENCY=4
AZAMI_JOB_TIMEOUT_SECONDS=900

# --- Rate limiting ---
AZAMI_RATELIMIT_BACKEND=memory
# AZAMI_REDIS_URL=redis://localhost:6379/0
